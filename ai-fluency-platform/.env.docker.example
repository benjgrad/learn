# Copy to .env.docker and fill in. .env.docker is gitignored.
# The anon key is printed by `npx supabase start` / `npx supabase status`.

# Public Supabase endpoint (nginx -> 127.0.0.1:54321). Baked into the client
# bundle at build time, so rebuild the image if this changes.
NEXT_PUBLIC_SUPABASE_URL=https://db.learning.gradyserver.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by the AI feedback / interview API routes.
ANTHROPIC_API_KEY=

# Stripe is not configured; the sparks purchase routes throw if hit.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase auth user ids (comma-separated) that may see the courses in
# content/private-courses.json. Read at runtime, so a restart applies a change.
# Unset means nobody sees them.
OWNER_USER_IDS=

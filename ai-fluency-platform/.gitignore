# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serwist (generated service worker)
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# supabase CLI local state + data dumps (contain user PII / auth hashes)
supabase/.temp/
supabase/dumps/
*.dump

# local docker env
.env.docker
supabase/signing_keys.json
!.env.docker.example

# Private courses: owner-only content that must never reach this public repo.
# Their ids start with "private-", so this one rule covers the registry, the
# generated review questions and every course directory. See CLAUDE.md.
content/private-*
